<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FC">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_arrow_back"
            app:tint="#19243A"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Chi tiết phòng"
            android:textColor="#19243A"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Thẻ thông tin phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_room_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtDetailCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1401"
                        android:textColor="#19243A"
                        android:textSize="30sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtDetailStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Trống"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Phòng học 1401"
                    android:textColor="#303B50"
                    android:textSize="15sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#EEF0F5"/>

                <!-- Mã phòng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mã phòng"
                        android:textColor="#8992A5"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtDetailRoomCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#263247"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Khu nhà -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Khu nhà"
                        android:textColor="#8992A5"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtDetailBuilding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#263247"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Tầng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tầng"
                        android:textColor="#8992A5"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtDetailFloor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#263247"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Trạng thái hiện tại -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trạng thái hiện tại"
                        android:textColor="#8992A5"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtDetailStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#263247"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Sửa trạng thái -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:text="Cập nhật trạng thái"
                android:textColor="#263247"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <RadioGroup
                android:id="@+id/rgStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_room_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <RadioButton
                    android:id="@+id/rbEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Trống"
                    android:textColor="#303B50"
                    android:textSize="14sp"
                    android:buttonTint="#239653"/>

                <RadioButton
                    android:id="@+id/rbInUse"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Đang sử dụng"
                    android:textColor="#303B50"
                    android:textSize="14sp"
                    android:buttonTint="#3264BB"/>

                <RadioButton
                    android:id="@+id/rbMaintenance"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Bảo trì"
                    android:textColor="#303B50"
                    android:textSize="14sp"
                    android:buttonTint="#B77B18"/>
            </RadioGroup>

            <Button
                android:id="@+id/btnSaveStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Lưu trạng thái"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#2447B2"
                app:cornerRadius="12dp"/>

            <!-- Thiết bị trong phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thiết bị trong phòng"
                        android:textColor="#263247"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtEquipmentSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="4 loại · 44 thiết bị"
                        android:textColor="#8992A5"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnAddEquipment"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_filter_selected"
                    android:gravity="center"
                    android:paddingHorizontal="15dp"
                    android:text="+ Thêm"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEquipments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_room_card"
                android:orientation="vertical"
                android:paddingVertical="4dp"/>

            <TextView
                android:id="@+id/txtEquipmentHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="4dp"
                android:text="Chạm để sửa · Nhấn giữ để xóa"
                android:textColor="#8992A5"
                android:textSize="12sp"/>

            <!-- Lịch sử thay đổi trạng thái -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:text="Lịch sử trạng thái"
                android:textColor="#263247"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/layoutHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_room_card"
                android:orientation="vertical"
                android:paddingVertical="4dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
