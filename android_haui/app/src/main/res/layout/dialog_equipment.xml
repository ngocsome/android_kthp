<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_section"
        android:paddingEnd="@dimen/space_section"
        android:paddingTop="@dimen/space_small"
        android:paddingBottom="@dimen/space_small">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Label"
            android:text="@string/equipment_name"
            android:labelFor="@id/edtEquipmentName" />

        <AutoCompleteTextView
            android:id="@+id/edtEquipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/bg_search"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:completionThreshold="1"
            android:inputType="textCapSentences"
            android:imeOptions="actionNext"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Label"
            android:text="@string/quantity"
            android:labelFor="@id/edtEquipmentQuantity"
            android:layout_marginTop="@dimen/space_medium" />

        <EditText
            android:id="@+id/edtEquipmentQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/bg_search"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:inputType="number"
            android:maxLength="4"
            android:imeOptions="actionDone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Label"
            android:text="@string/condition"
            android:layout_marginTop="@dimen/space_medium" />

        <RadioGroup
            android:id="@+id/rgCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/rbGood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/good"
                android:textSize="16sp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbBroken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/broken"
                android:textSize="16sp" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
