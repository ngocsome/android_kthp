<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/filterLimit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/FilterLimit" />

    <ScrollView
        android:id="@+id/filtersPanel"
        android:layout_width="0dp"
        style="@style/FilterPanel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingTop="@dimen/space_medium"
            android:focusableInTouchMode="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Screen"
                android:text="@string/nav_management"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Meta"
                android:text="@string/management_hint"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Label"
                android:text="@string/floor_filter"
                android:layout_marginTop="@dimen/space_small" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="8dp">
                <com.google.android.material.chip.Chip
                    android:id="@+id/btnFloorAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="@string/floor_all"
                    android:checkable="true"
                    app:ensureMinTouchTargetSize="true"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnFloor14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="@string/floor_14"
                    android:checkable="true"
                    app:ensureMinTouchTargetSize="true"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnFloor15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="@string/floor_15"
                    android:checkable="true"
                    app:ensureMinTouchTargetSize="true"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnFloor16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="@string/floor_16"
                    android:checkable="true"
                    app:ensureMinTouchTargetSize="true"
                    app:chipMinTouchTargetSize="48dp" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/txtStatusCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Meta"
                android:paddingBottom="@dimen/space_small" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/FilterResults"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ListView
            android:id="@+id/lvStatusRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="@dimen/space_medium"
            android:listSelector="?attr/selectableItemBackground"
            android:drawSelectorOnTop="true" />

        <TextView
            android:id="@+id/txtManagementEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Body"
            android:text="@string/no_rooms"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
