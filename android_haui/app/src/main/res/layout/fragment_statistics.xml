<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingTop="@dimen/space_medium"
        android:paddingBottom="@dimen/space_section">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Screen"
            android:text="@string/nav_statistics_label"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_medium"
            android:background="@drawable/overview_total_bg"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Label"
                android:text="@string/overview_total_label"
                android:textColor="@color/hero_ink" />

            <TextView
                android:id="@+id/txtTotalRooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Metric"
                android:textColor="@color/hero_ink" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Section"
            android:text="@string/room_status"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/space_section" />

        <include android:id="@+id/statEmpty" layout="@layout/item_stat_status" />

        <include android:id="@+id/statInUse" layout="@layout/item_stat_status" />

        <include android:id="@+id/statMaintenance" layout="@layout/item_stat_status" />

        <TextView
            android:id="@+id/txtSelectedStatusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Section"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/space_section" />

        <LinearLayout
            android:id="@+id/layoutStatusRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txtStatusRoomsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Meta"
            android:text="@string/no_status_rooms" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Section"
            android:text="@string/stats_floor"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/space_section" />

        <LinearLayout
            android:id="@+id/layoutFloorStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_small"
            android:background="@drawable/bg_room_card"
            android:padding="@dimen/space_medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Section"
            android:text="@string/stats_broken"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/space_section" />

        <TextView
            android:id="@+id/txtBrokenSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Meta" />

        <LinearLayout
            android:id="@+id/layoutBrokenRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_room_card"
            android:layout_marginTop="@dimen/space_small" />
    </LinearLayout>
</ScrollView>
