<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/filterLimit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/FilterLimit" />

    <ScrollView
        android:id="@+id/filtersPanel"
        android:layout_width="0dp"
        style="@style/FilterPanel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingTop="@dimen/space_medium"
            android:focusableInTouchMode="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Screen"
                android:text="@string/nav_rooms_label"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Label"
                android:text="@string/search_label"
                android:labelFor="@id/edtSearchRoom"
                android:layout_marginTop="@dimen/space_small" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search"
                android:layout_marginTop="4dp">
                <EditText
                    android:id="@+id/edtSearchRoom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="@dimen/space_small"
                    android:background="@android:color/transparent"
                    app:drawableStartCompat="@drawable/ic_search"
                    android:drawablePadding="8dp"
                    app:drawableTint="@color/text_gray"
                    android:hint="@string/room_search_hint"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <ImageButton
                    android:id="@+id/btnClearRoomSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_clear_search"
                    app:tint="@color/text_gray"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/room_clear_search"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Label"
                android:text="@string/room_status"
                android:layout_marginTop="@dimen/space_small" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="8dp">
                <com.google.android.material.chip.Chip
                    android:id="@+id/btnFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="@string/room_status_all"
                    android:checkable="true"
                    app:ensureMinTouchTargetSize="true"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnFilterEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="@string/overview_empty"
                    android:checkable="true"
                    app:ensureMinTouchTargetSize="true"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnFilterInUse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="@string/overview_in_use"
                    android:checkable="true"
                    app:ensureMinTouchTargetSize="true"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnFilterMaintenance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="@string/overview_maintenance"
                    android:checkable="true"
                    app:ensureMinTouchTargetSize="true"
                    app:chipMinTouchTargetSize="48dp" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/txtRoomCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Haui.Meta"
                android:paddingBottom="@dimen/space_small" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/FilterResults"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ListView
            android:id="@+id/lvRoomList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="@dimen/space_medium"
            android:listSelector="?attr/selectableItemBackground"
            android:drawSelectorOnTop="true" />

        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Haui.Body"
            android:text="@string/room_search_empty"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
