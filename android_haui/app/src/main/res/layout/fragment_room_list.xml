<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FC"
    android:paddingTop="16dp">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phòng học"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#19243A"
        android:paddingHorizontal="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tra cứu và quản lý danh sách phòng"
        android:textSize="13sp"
        android:textColor="#8992A5"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="18dp"/>

    <!-- Tìm kiếm -->
    <EditText
        android:id="@+id/edtSearchRoom"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_search"
        android:hint="Nhập mã phòng..."
        android:textSize="14sp"
        android:singleLine="true"
        android:inputType="text"/>

    <!-- Bộ lọc trạng thái -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Tất cả"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:background="@drawable/bg_filter_selected"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/btnFilterEmpty"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Trống"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_normal"
                android:textColor="#29965C"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/btnFilterInUse"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Đang sử dụng"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_normal"
                android:textColor="#3264BB"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/btnFilterMaintenance"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Bảo trì"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_normal"
                android:textColor="#B77B18"
                android:textSize="12sp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Số lượng phòng -->
    <TextView
        android:id="@+id/txtRoomCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="15 phòng học"
        android:textColor="#263247"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"/>

    <!-- Danh sách phòng -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvRoomList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:background="@android:color/transparent"/>

        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Không tìm thấy phòng học"
            android:textColor="#8992A5"
            android:textSize="14sp"
            android:visibility="gone"/>

    </FrameLayout>

</LinearLayout>
