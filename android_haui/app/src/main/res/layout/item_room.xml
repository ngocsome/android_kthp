<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_room_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtRoomCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1401"
            android:textColor="#19243A"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtRoomStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trống"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/txtRoomName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phòng học 1401"
        android:textColor="#303B50"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/txtRoomFloor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tầng 14"
        android:textColor="#8992A5"
        android:textSize="12sp"
        android:layout_marginTop="6dp"/>

</LinearLayout>
