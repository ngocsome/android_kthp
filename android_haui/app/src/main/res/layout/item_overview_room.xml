<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_room_card"
    android:padding="@dimen/space_medium"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:id="@+id/recentCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Haui.Section" />

    <TextView
        android:id="@+id/recentFloor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Haui.Meta" />

    <TextView
        android:id="@+id/recentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Haui.Label"
        android:layout_marginTop="@dimen/space_small"
        android:paddingStart="@dimen/space_small"
        android:paddingEnd="@dimen/space_small"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:drawablePadding="4dp" />
</LinearLayout>
