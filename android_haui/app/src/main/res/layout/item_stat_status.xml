<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_room_card"
    android:padding="@dimen/space_medium"
    android:minHeight="@dimen/touch_target"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginTop="@dimen/space_small">
    <TextView
        android:id="@+id/txtStatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Haui.Label"
        android:paddingStart="@dimen/space_small"
        android:paddingEnd="@dimen/space_small"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:drawablePadding="4dp" />

    <TextView
        android:id="@+id/txtStatValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Haui.Body"
        android:layout_marginTop="@dimen/space_small" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressStat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_small"
        android:importantForAccessibility="no"
        android:max="100"
        app:trackThickness="8dp"
        app:trackCornerRadius="4dp"
        app:trackColor="@color/border" />
</LinearLayout>
